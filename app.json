{
  "expo": {
    "name": "Tribu Famille",
    "slug": "tribu-famille",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B4B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.tribufamille.app",
      "appleTeamId": "NTNAWJQ2N3",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Tribu a besoin de l'appareil photo pour ajouter des photos au journal de famille.",
        "NSPhotoLibraryUsageDescription": "Tribu accède à vos photos pour partager vos moments et avatars avec la famille.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.tribufamille.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1E1B4B"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Tribu accède à vos photos pour partager vos moments avec la famille.",
          "cameraPermission": "Tribu utilise l'appareil photo pour publier sur le journal de famille."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366F1"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5e13c5be-011f-49d8-8bf3-1117f2e01640"
      }
    },
    "owner": "fatellim"
  }
}
